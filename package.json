{
	"name": "vandelay",
	"private": true,
	"version": "0.1.0",
	"workspaces": [
		"web",
		"server"
	],
	"scripts": {
		"dev": "concurrently -n server,web -c blue,magenta \"npm:dev -w server\" \"npm:dev -w web\"",
		"build": "npm run build -w server && npm run build -w web",
		"start": "npm run start -w server"
	},
	"devDependencies": {
		"concurrently": "^9.0.1"
	}
}
